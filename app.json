{
  "expo": {
    "name": "Thrivlingo",
    "slug": "thrivlingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "es.harmat.thrivlingo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Thrivlingo uses the microphone so you can talk with the characters.",
          "speechRecognitionPermission": "Thrivlingo turns your voice into text so the characters can understand you."
        }
      ]
    ],
    "owner": "harmat"
  }
}
